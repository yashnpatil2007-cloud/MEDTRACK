# ==========================================
# MEDTRACK Environment Configuration Template
# ==========================================

# Flask Environment Mode: 'development', 'testing', or 'production'
FLASK_ENV=development

# Server Port
PORT=5000
HOST=0.0.0.0

# Cryptographic Keys (Generate 64-char random hex in production)
SECRET_KEY=replace-with-ultra-secure-random-secret-key-32-chars-min
JWT_SECRET_KEY=replace-with-ultra-secure-jwt-secret-key-32-chars-min
JWT_EXPIRATION_HOURS=24

# Database Configuration
# SQLite (Local Development default):
DATABASE_URL=sqlite:///medtrack.db
# PostgreSQL (Production deployment):
# DATABASE_URL=postgresql://medtrack_user:medtrack_password@localhost:5432/medtrack_db

# CORS Configuration
CORS_ORIGINS=*

# Super Administrator Bootstrap (Auto-provisioned on initial boot)
SUPERADMIN_ID=superadmin
SUPERADMIN_PASSWORD=SuperAdmin@MedTrack2026

# External Services (Disclosed limitations)
# OpenStreetMap / OSRM Routing public server (Default used)
OSRM_ROUTING_URL=https://router.project-osrm.org
# Live Commercial Traffic API Key (TomTom / HERE / Google) - Optional
# When omitted, MEDTRACK uses OSRM static topology and marks advisories as SIMULATED
TRAFFIC_DATA_API_KEY=
